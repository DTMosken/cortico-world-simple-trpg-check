{
  "name": "cortico-world-simple-trpg-check",
  "version": "0.2.3",
  "type": "module",
  "description": "Cortico 的 TRPG 技能检定 World 扩展，使用本地或远程模型评估技能水平，支持 d100 掷骰、组合与对抗检定。",
  "license": "MIT",
  "author": "DTMosken",
  "keywords": [
    "cortico-world",
    "cortico"
  ],
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@11.5.0",
  "main": "./src/index.ts",
  "cortico": {
    "kind": "world",
    "api": 5,
    "consoleClient": "dist/console.js"
  },
  "files": [
    "src",
    "python",
    "dist",
    "README.md"
  ],
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "typecheck:web": "tsc -p tsconfig.web.json --noEmit",
    "build:console": "esbuild src/console/client.ts --bundle --format=esm --outfile=dist/console.js",
    "eval:scenarios": "tsx evals/run.ts",
    "eval:probe": "tsx evals/probe.ts",
    "eval:train": "tsx evals/train.ts"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "cortico": "^0.1.3",
    "esbuild": "^0.28.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "optionalDependencies": {
    "@receptron/laya": "0.1.2"
  }
}
